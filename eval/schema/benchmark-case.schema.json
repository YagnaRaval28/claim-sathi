{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimsathi.in/eval/benchmark-case.schema.json",
  "title": "ClaimSathi benchmark case",
  "description": "One evaluation case for the ClaimSathi AI pipeline (docs/04-ai/evaluation-plan.md §9). Ground truth names clauses by reference only; verbatim quotes are copied from ingested chunk text at annotation time, never typed from memory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "benchmark_version", "split", "provenance", "strata", "languages", "inputs", "ground_truth", "annotation"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^(SYN|RC|REG)-[0-9]{3,5}$", "description": "SYN = synthetic, RC = consented real (de-identified), REG = regression replica" },
    "benchmark_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+(-[a-z]+)?$" },
    "split": { "enum": ["dev", "test", "regression", "sample"] },
    "provenance": { "enum": ["synthetic", "consented_real_deidentified", "synthetic_replica"] },
    "strata": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["typical_partial", "typical_repudiation", "rule_edge", "missing_evidence", "conflicting_evidence", "ambiguous", "adversarial", "out_of_scope", "must_abstain", "escalation_deadline"] }
    },
    "languages": {
      "type": "object", "additionalProperties": false, "required": ["display", "letter"],
      "properties": { "display": { "$ref": "#/$defs/lang" }, "letter": { "$ref": "#/$defs/lang" } }
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["eligibility", "documents", "wording", "events", "as_of_date"],
      "properties": {
        "eligibility": {
          "type": "object", "additionalProperties": false,
          "required": ["health_india", "situation", "policy_type", "relation", "in_litigation"],
          "properties": {
            "health_india": { "enum": ["yes", "no", "not_sure"] },
            "situation": { "enum": ["rejected", "partly_paid", "delayed", "other"] },
            "policy_type": { "enum": ["individual", "floater", "group", "unknown"] },
            "relation": { "enum": ["self", "spouse", "parent", "child", "other"] },
            "in_litigation": { "enum": ["yes", "no", "not_sure"] },
            "decision_month": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" }
          }
        },
        "documents": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["doc_id", "type", "source_kind"],
            "properties": {
              "doc_id": { "type": "string", "pattern": "^D[0-9]+$" },
              "type": { "$ref": "#/$defs/doc_type" },
              "source_kind": { "enum": ["text_fixture", "pdf_fixture", "photo_capture"] },
              "text": { "type": "string", "minLength": 1 },
              "file_ref": { "type": "string" },
              "capture": {
                "type": "object", "additionalProperties": false,
                "required": ["device", "lighting", "tilt_deg", "paper"],
                "properties": {
                  "device": { "enum": ["low_end_android", "mid_range_android"] },
                  "lighting": { "enum": ["dim", "normal", "bright"] },
                  "tilt_deg": { "enum": [0, 10, 20] },
                  "paper": { "enum": ["flat", "creased"] }
                }
              }
            },
            "allOf": [
              { "if": { "properties": { "source_kind": { "const": "text_fixture" } } }, "then": { "required": ["text"] } },
              { "if": { "properties": { "source_kind": { "enum": ["pdf_fixture", "photo_capture"] } } }, "then": { "required": ["file_ref"] } },
              { "if": { "properties": { "source_kind": { "const": "photo_capture" } } }, "then": { "required": ["capture"] } }
            ]
          }
        },
        "wording": {
          "type": "object", "additionalProperties": false, "required": ["mode"],
          "properties": {
            "mode": { "enum": ["library", "uploaded", "none"] },
            "source_identifier": { "type": "string", "description": "e.g. SAMPLE-WORDING-001; versions resolved by admission date" }
          },
          "if": { "properties": { "mode": { "enum": ["library", "uploaded"] } } },
          "then": { "required": ["source_identifier"] }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "event_date"],
            "properties": {
              "kind": { "enum": ["s1_sent", "insurer_reply", "s2_filed", "s3_filed", "ombudsman_outcome", "payment_received", "closed"] },
              "event_date": { "$ref": "#/$defs/date" },
              "metadata": { "type": "object" }
            }
          }
        },
        "as_of_date": { "$ref": "#/$defs/date", "description": "Injected clock (IST) for deadline and rule evaluation" }
      }
    },
    "ground_truth": {
      "type": "object", "additionalProperties": false,
      "required": ["out_of_scope", "expected_mode", "fields", "reasons", "line_items", "expected_rule_results", "expected_deadlines", "relevant_clause_refs", "acceptable_points", "must_abstain_targets", "must_not_contain", "expected_flags"],
      "properties": {
        "out_of_scope": { "type": "boolean" },
        "expected_mode": { "enum": ["full", "limited", "delay", null] },
        "fields": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/field_name" },
          "additionalProperties": { "type": ["string", "integer", "null"] }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["ref", "text_verbatim", "clause_cited_verbatim", "category", "expected_audit_status"],
            "properties": {
              "ref": { "type": "string", "pattern": "^R[0-9]+$" },
              "text_verbatim": { "type": "string" },
              "clause_cited_verbatim": { "type": ["string", "null"] },
              "category": { "$ref": "#/$defs/category" },
              "expected_audit_status": { "anyOf": [{ "$ref": "#/$defs/audit_status" }, { "type": "null" }], "description": "null = judged by domain reviewer rubric" }
            }
          }
        },
        "line_items": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["ref", "description", "billed_paise", "deducted_paise", "reason_verbatim", "clause_cited_verbatim", "category", "expected_audit_status"],
            "properties": {
              "ref": { "type": "string", "pattern": "^L[0-9]+$" },
              "description": { "type": "string" },
              "billed_paise": { "type": ["integer", "null"], "minimum": 0 },
              "deducted_paise": { "type": "integer", "minimum": 0 },
              "reason_verbatim": { "type": "string" },
              "clause_cited_verbatim": { "type": ["string", "null"] },
              "unitemised": { "type": "boolean" },
              "category": { "$ref": "#/$defs/category" },
              "expected_audit_status": { "anyOf": [{ "$ref": "#/$defs/audit_status" }, { "type": "null" }] }
            }
          }
        },
        "expected_rule_results": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["rule_key", "result"],
            "properties": {
              "rule_key": { "type": "string", "pattern": "^RULE-(ESC|MC)-[0-9]{2}$" },
              "result": { "enum": ["pass", "block", "warn", "inform", "fires", "not_fires"] }
            }
          }
        },
        "expected_deadlines": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "due_date"],
            "properties": {
              "kind": { "enum": ["ombudsman_eligible_from", "ombudsman_limitation", "insurer_response_expected", "ombudsman_award_expected"] },
              "due_date": { "$ref": "#/$defs/date" },
              "note": { "type": "string" }
            }
          }
        },
        "relevant_clause_refs": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["target_ref", "source_identifier", "clause_ref"],
            "properties": {
              "target_ref": { "type": "string", "pattern": "^[RL][0-9]+$" },
              "source_identifier": { "type": "string" },
              "clause_ref": { "type": "string" }
            }
          }
        },
        "acceptable_points": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["target_ref", "basis_type", "gist"],
            "properties": {
              "target_ref": { "type": "string", "pattern": "^[RL][0-9]+$" },
              "basis_type": { "enum": ["regulation", "policy_wording", "case_fact", "deterministic_rule"] },
              "source_identifier": { "type": "string" },
              "clause_ref": { "type": "string" },
              "rule_key": { "type": "string" },
              "gist": { "type": "string", "description": "Paraphrase of the acceptable argument; not a quote" }
            }
          }
        },
        "must_abstain_targets": { "type": "array", "items": { "type": "string", "pattern": "^([RL][0-9]+|ALL)$" } },
        "must_not_contain": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "expected_flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false, "required": ["annotators", "adjudicated", "notes"],
      "properties": {
        "annotators": { "type": "array", "items": { "type": "string" } },
        "adjudicated": { "type": "boolean" },
        "kappa_batch": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "lang": { "enum": ["en", "gu", "hi"] },
    "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "doc_type": { "enum": ["decision_letter", "settlement_breakup", "policy_schedule", "policy_wording", "discharge_summary", "final_bill", "reports", "insurer_correspondence", "other"] },
    "category": { "enum": ["ped_waiting", "non_disclosure", "specific_waiting", "initial_waiting", "exclusion", "not_medically_necessary", "documents_or_intimation", "policy_not_in_force", "non_payable_items", "room_rent_proportionate", "reasonable_customary", "sub_limit", "copay_deductible", "other_unknown"] },
    "audit_status": { "enum": ["NO_CLAUSE_CITED", "CLAUSE_NOT_FOUND", "CLAUSE_FOUND_QUESTIONABLE", "CLAUSE_FOUND_APPEARS_VALID", "CANNOT_ASSESS"] },
    "field_name": { "enum": ["insurer", "tpa", "policy_number", "product_name", "product_uin", "policy_type", "first_inception_date", "policy_period_from", "policy_period_to", "sum_insured_paise", "patient_name", "hospital", "admission_date", "discharge_date", "claim_number", "claim_type", "claimed_paise", "paid_paise", "disallowed_paise", "decision_letter_date", "decision_type", "grievance_contact"] }
  }
}
