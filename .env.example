# ClaimSathi environment variables: EXAMPLE ONLY
# ---------------------------------------------------------------------------
# - Placeholders only. Never put real secrets in this file, and never commit a real .env.
# - Local development: copy to `.env` (git-ignored) and fill in the values you need.
# - Staging and prod: real values live in ONE Secret Manager JSON bundle per
#   environment (system-design §1.1, §C.6). Cloud Run gets only the
#   non-secret values below plus SECRET_BUNDLE_NAME.
# - Lines marked [secret] belong in the bundle in the cloud.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
APP_ENV=local                                   # local | staging | prod
LOG_LEVEL=info                                  # debug | info | warning | error
PUBLIC_BASE_URL=http://localhost:3000           # browser origin (Next.js); *.run.app in the MVP cloud
API_UPSTREAM_URL=http://localhost:8000          # Next.js rewrites /api/* to this URL
WORKER_URL=http://localhost:8001                # task handler service (local: in-process task runner)

# --- Database (local: docker compose Postgres + pgvector) -------------------
# Local: docker compose Postgres on host port 5433 (5432 is often taken by a native PostgreSQL).
# <local-db-password>: the local-only value set in docker-compose.yml (or infra/local/native-postgres-setup.sql).
# Native PostgreSQL (development-setup §3a): use port 5432 instead.
SUPABASE_DB_URL=postgresql+psycopg://claimsathi:<local-db-password>@localhost:5433/claimsathi   # [secret] in cloud: Supabase pooler URL
TEST_DATABASE_URL=postgresql+psycopg://claimsathi:<local-db-password>@localhost:5433/claimsathi_test

# --- Object storage (local: MinIO; cloud: Supabase Storage S3-compatible) --
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=ap-south-1
STORAGE_BUCKET_CASES=cases
STORAGE_BACKEND=s3                               # s3 (MinIO/Supabase) | memory (tests)
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_EXPORTS=exports
STORAGE_BUCKET_KB=kb
SUPABASE_STORAGE_KEY=<storage-access-key>        # local: MinIO user from docker-compose.yml; [secret] in cloud, server-side only
SUPABASE_STORAGE_SECRET=<storage-secret-key>     # local: MinIO password from docker-compose.yml; [secret] in cloud
SUPABASE_STORAGE_TUS_ENDPOINT=                   # set only if spike S-2 approves direct TUS uploads (CI-04)

# --- Security --------------------------------------------------------------
FIELD_DATA_KEY=<base64-32-byte-key>              # [secret] AES-256-GCM key for identity fields
HASH_PEPPER=<random-64-hex>                      # [secret] HMAC pepper for email and pseudonymous IDs
CODE_PEPPER=<random-64-hex>                      # [secret] HMAC pepper for sign-in codes
CSRF_SECRET=<random-64-hex>                      # [secret]
SESSION_COOKIE_NAME=cs_session
ADMIN_COOKIE_NAME=cs_admin
ADMIN_BOOTSTRAP_EMAIL=<admin@example.com>        # first admin, allowlisted for Google sign-in + TOTP

# --- Google OAuth (consumer and admin clients are separate) ----------------
GOOGLE_OAUTH_CLIENT_ID=<consumer-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<consumer-client-secret>   # [secret]
ADMIN_OAUTH_CLIENT_ID=<admin-client-id>
ADMIN_OAUTH_CLIENT_SECRET=<admin-client-secret>       # [secret]

# --- Email (local: Mailpit SMTP; cloud: Amazon SES ap-south-1 API) ---------
MAILER=smtp                                      # smtp (local Mailpit) | ses (M9) | memory (tests)
MAIL_FROM=ClaimSathi <no-reply@claimsathi.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SES_REGION=ap-south-1
SES_FROM_ADDRESS=<no-reply@your-domain>          # needs a verified identity (CI-23)
SES_ACCESS_KEY_ID=<aws-access-key-id>            # [secret]
SES_SECRET_ACCESS_KEY=<aws-secret-access-key>    # [secret]

# --- AI (model and OCR) ----------------------------------------------------
LLM_PROVIDER=fake                                # fake (recorded fixtures) | gemini_dev (free tier: SYNTHETIC DATA ONLY, D-008) | vertex
LLM_MODEL_ID=gemini-2.5-flash                    # final choice by bake-off (UD-01)
EMBEDDING_PROVIDER=fake                          # fake | vertex
EMBEDDING_MODEL_ID=text-embedding-005
GEMINI_DEV_API_KEY=<gemini-developer-api-key>    # [secret] spike S-5 only; never used with real documents
VERTEX_LOCATION=asia-south1
OCR_ENGINE=fake                                  # fake | tesseract (local) | docai
DOCAI_PROCESSOR_NAME=<projects/.../locations/asia-south1/processors/...>
CLAMD_HOST=localhost
CLAMD_PORT=3310

# --- GCP (cloud only, from M9) ---------------------------------------------
GCP_PROJECT_ID=<gcp-project-id>
GCP_REGION=asia-south1
TASK_QUEUE=inprocess                             # inprocess (local) | cloudtasks
TASKS_QUEUE_DOCS=docs
TASKS_QUEUE_AI=ai
TASKS_QUEUE_IO=io
TASKS_INVOKER_SA=<tasks-invoker@project.iam.gserviceaccount.com>
SECRET_BUNDLE_NAME=<projects/.../secrets/claimsathi-bundle>

# --- Budgets and free-tier guardrails --------------------------------------
CREDIT_BUDGET_USD=300
CREDIT_GUARD_PCT=90
QUOTA_ALERT_PCT=80
STORAGE_GUARD_PCT=95                             # refuse new uploads above this (CI-10, pending decision D-E)

# --- Backups (cloud only) --------------------------------------------------
BACKUP_STORAGE_KEY=<backup-bucket-key>           # [secret]
BACKUP_AGE_PUBLIC_KEY=<age1...>                  # public key only; the private key stays OFFLINE with the product owner

# --- Observability ---------------------------------------------------------
SENTRY_DSN_API=                                  # [secret] empty = disabled
NEXT_PUBLIC_SENTRY_DSN_WEB=                      # empty = disabled; EU-region org; scrubbing mandatory

# --- Feature flags (P1) ----------------------------------------------------
FEATURE_BIMA_BHAROSA_PACK=false
FEATURE_ADMIN_METRICS=false
FEATURE_ICS_EXPORT=false
